Options -MultiViews
RewriteEngine On

# Redirigir www a no-www (opcional)
# RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
# RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Servir archivos estáticos de Next.js
# Si el archivo existe, servirlo directamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Para rutas con /index.html generadas por next export
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# Fallback: intentar con .html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Página de error 404
ErrorDocument 404 /404/index.html

# Cache para assets estáticos
<FilesMatch "\.(css|js|woff|woff2|png|jpg|jpeg|gif|svg|ico|webp|avif)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Sin cache para HTML
<FilesMatch "\.html$">
  Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
